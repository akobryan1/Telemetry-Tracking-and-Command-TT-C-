# TT&C Simulation - Environment Variables Template
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env with actual secrets to Git!

# Flask Configuration
FLASK_ENV=production
PORT=5000

# Database Mode
# Options: "csv" or "database"
# Set to "database" to enable Supabase PostgreSQL logging
DATABASE_MODE=csv

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local Development
# For local testing, set DATABASE_MODE=csv and leave Supabase vars empty
# For cloud testing, set DATABASE_MODE=database and fill in Supabase credentials
